@namespace BugViewer
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="scene-viewer @(HideHeader ? "embedded" : null)">
    @if (!HideHeader)
    {
    <header class="scene-viewer-header">
        <div>
            <span class="scene-id">#@ViewerId</span>
            @if (IsActive) { <span class="active-badge">Active</span> }
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Heading)) { <p>@Heading</p> }
        </div>
        @if (OnClose.HasDelegate)
        {
            <FluentButton Class="rotated-icon-button" OnClick="CloseAsync" IconStart="@(new Icons.Regular.Size20.Add())"
                          Title="Close viewer" aria-label="Close viewer" />
        }
    </header>
    }
    @if (StepCount > 1)
    {
        <div class="step-controls"><button @onclick="PreviousStep">Prev</button><input type="range" min="0" max="@(StepCount - 1)" @bind="step" @bind:after="RenderCurrentAsync" /><span>@(step + 1) / @StepCount</span><button @onclick="NextStep">Next</button></div>
    }
    <div class="plot-viewer" @ref="plotElement"></div>
</section>
