@using FileIcons = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24
@using Microsoft.FluentUI.AspNetCore.Components
@namespace BugViewer
@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="container" class="scene-viewer" tabindex="0" aria-label="Scene viewer"
         data-scene-shortcuts="@(EnableFileShortcuts ? "true" : "false")" data-scene-open-enabled="@(EnableOpenScene ? "true" : "false")" aria-busy="@isBusy.ToString().ToLowerInvariant()">
    <InputFile @ref="fileInput" OnChange="OpenSceneFileAsync" accept=".json,.bugscene" hidden disabled="@(isBusy || !EnableOpenScene)" />
    <button @ref="openButton" type="button" hidden disabled="@(isBusy || !EnableOpenScene)" data-scene-file-command="open"></button>
    <button @ref="saveButton" type="button" hidden disabled="@(isBusy || ActiveScenes.Count == 0)" @onclick="BeginSaveAsAsync"></button>
    @if (loading is not null)
    {
        <div class="scene-file-progress" role="status">
            <progress value="@loadPercent" max="100" aria-label="Scene loading progress"></progress>
            <button type="button" @onclick="CancelOpen">Cancel opening</button>
        </div>
    }
    @if (fileError is not null)
    {
        <p class="scene-file-error" role="alert">@fileError</p>
    }

    @if (CurrentRequest.Kind == PresentationKind.TwoDimensional)
    {
        <div class="plot-file-actions" aria-label="Scene file actions">
            @if (EnableOpenScene)
            {
                <FluentButton IconOnly="true" Disabled="@isBusy" data-scene-file-command="open" Title="Open scene (Ctrl+Alt+O)" aria-label="Open scene">
                    <FluentIcon Value="@(new FileIcons.FolderOpen())" />
                </FluentButton>
            }
            <FluentButton IconOnly="true" Disabled="@(isBusy || ActiveScenes.Count == 0)" OnClick="BeginSaveAsAsync" Title="Save scene as (Ctrl+Alt+S)" aria-label="Save scene as">
                <FluentIcon Value="@(new FileIcons.Save())" />
            </FluentButton>
        </div>
        <PlotViewer @key="generation" @ref="plotViewer" ViewerId="ViewerId" IsActive="IsActive"
                    Scenes="ActiveScenes" OnClose="OnClose" OnReady="OnReady" />
    }
    else
    {
    <header class="scene-viewer-header">
        <div>
            <span class="scene-id">#@ViewerId</span>
            @if (IsActive) { <span class="active-badge">Active</span> }
            <h2>@(Current.Title.Length == 0 ? "3D Scene" : Current.Title)</h2>
            @if (!string.IsNullOrWhiteSpace(Current.Heading)) { <p>@Current.Heading</p> }
            @if (!string.IsNullOrWhiteSpace(Current.Subtitle)) { <p>@Current.Subtitle</p> }
        </div>
        @if (OnClose.HasDelegate)
        {
            <FluentButton Class="rotated-icon-button" OnClick="CloseAsync" IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Add())"
                          Title="Close viewer" aria-label="Close viewer" />
        }
    </header>
    @if (StepCount > 1)
    {
        <div class="step-controls">
            <button @onclick="PreviousStepAsync">Prev</button>
            <input type="range" min="0" max="@(StepCount - 1)" @bind="step"
                   @bind:event="oninput" @bind:after="RenderSceneAsync" />
            <span class="step-counter">
                @if (isEditingStep)
                {
                    <input @ref="stepInput" class="step-number-input" type="text" inputmode="numeric"
                           aria-label="Target step" title="Enter a step number; Enter applies, Escape cancels"
                           style="width: @(Math.Max(3, StepCount.ToString().Length) + 1)ch"
                           @bind="targetStep" @bind:event="oninput"
                           @onkeyup="StepInputKeyUpAsync" @onblur="ApplyTargetStepAsync" />
                }
                else
                {
                    <button @ref="stepButton" type="button" class="step-current" aria-label="Edit current step"
                            title="Click to jump to a step" @onclick="BeginStepEditAsync">@(step + 1)</button>
                }
                <span>/ @StepCount</span>
            </span>
            <button @onclick="NextStepAsync">Next</button>
            <button @onclick="ToggleAutoplayAsync">@(IsAutoplaying ? "Pause" : "Play")</button>
            <label class="step-speed-control">
                Speed
                <select @bind="autoplayDelayMilliseconds">
                    <option value="33">30 fps</option>
                    <option value="100">10 fps</option>
                    <option value="333">3 fps</option>
                    <option value="1000">1 fps</option>
                    <option value="3000">1 frame / 3 sec</option>
                </select>
            </label>
            <label class="step-speed-control">
                Step stride
                <input type="number" min="1" max="@Math.Max(1, StepCount - 1)"
                       @bind="stepStride" />
            </label>
        </div>
    }
    <div class="scene-viewer-canvas">
        <BugViewer @key="generation" @ref="viewer" Height="100%" Width="100%" OnReady="OnViewerReadyAsync"
                   Options="initialOptions" HoverSelectionKeys="HoverSelectionKeys" OnHoverSelectionKeyChanged="OnHoverSelectionKeyChanged"
                   OnTriangleSelected="TriangleSelectedAsync"
                   AutoResetCamera="@(CurrentRequest.Options is null ? Current.AutoResetCamera : (UpdateTypes?)null)">
            <CameraActions>
                @CameraActions
                <FluentStack Orientation="Orientation.Horizontal" aria-label="Scene file actions">
                    @if (EnableOpenScene)
                    {
                        <FluentButton IconOnly="true" Disabled="@isBusy" data-scene-file-command="open" Title="Open scene (Ctrl+Alt+O)" aria-label="Open scene">
                            <FluentIcon Value="@(new FileIcons.FolderOpen())" />
                        </FluentButton>
                    }
                    <FluentButton IconOnly="true" Disabled="@(isBusy || ActiveScenes.Count == 0)" OnClick="BeginSaveAsAsync" Title="Save scene as (Ctrl+Alt+S)" aria-label="Save scene as">
                        <FluentIcon Value="@(new FileIcons.Save())" />
                    </FluentButton>
                </FluentStack>
            </CameraActions>
        </BugViewer>
    </div>
    }
    <dialog @ref="saveAsDialog" class="scene-save-dialog" aria-labelledby="@saveAsTitleId">
        <form @onsubmit="ConfirmSaveAsAsync" @onsubmit:preventDefault>
            <h2 id="@saveAsTitleId">Save scene as</h2>
            <label>File name <input @ref="saveAsInput" type="text" @bind="saveAsName" @bind:event="oninput" maxlength="240" /></label>
            <p>The file includes all steps and the current view.</p>
            @if (saveAsError is not null) { <p class="scene-file-error" role="alert">@saveAsError</p> }
            <div class="scene-save-actions">
                <button type="button" @onclick="CancelSaveAsAsync">Cancel</button>
                <button type="submit">Save</button>
            </div>
        </form>
    </dialog>
</section>
