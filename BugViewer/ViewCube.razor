@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20

<div @ref="_overlayElement"
     class="view-cube-overlay"
     hidden="@(!Visible)"
     @onpointerdown="HandlePointerDownAsync"
     @onpointerdown:stopPropagation
     @onpointermove="HandlePointerMoveAsync"
     @onpointermove:stopPropagation
     @onpointerup="HandlePointerUpAsync"
     @onpointerup:stopPropagation
     @onmousedown:stopPropagation
     @onmouseup:stopPropagation
     @onwheel:stopPropagation
     @onwheel:preventDefault
     @onkeydown:stopPropagation
     @oncontextmenu:preventDefault>
    <button type="button"
            class="view-cube-reset"
            title="Reset Camera"
            aria-label="Reset Camera"
            @onpointerdown:stopPropagation
            @onclick="OnReset"
            @onclick:stopPropagation>
        <FluentIcon Value="@(new Icons.Sparkle())" />
    </button>
    <div class="view-cube-stage">
        <div @ref="_rotorElement" class="view-cube-rotor">
            <button type="button" class="view-cube-face view-cube-face-positive-x" data-view-cube-normal="1,0,0" title="View +X" aria-label="View from positive X" @onclick="@(() => SelectDirectionAsync(CardinalDirection.PositiveX))" @onclick:stopPropagation><span>+X</span></button>
            <button type="button" class="view-cube-face view-cube-face-negative-x" data-view-cube-normal="-1,0,0" title="View -X" aria-label="View from negative X" @onclick="@(() => SelectDirectionAsync(CardinalDirection.NegativeX))" @onclick:stopPropagation><span>-X</span></button>
            <button type="button" class="view-cube-face view-cube-face-positive-y" data-view-cube-normal="0,1,0" title="View +Y" aria-label="View from positive Y" @onclick="@(() => SelectDirectionAsync(CardinalDirection.PositiveY))" @onclick:stopPropagation><span>+Y</span></button>
            <button type="button" class="view-cube-face view-cube-face-negative-y" data-view-cube-normal="0,-1,0" title="View -Y" aria-label="View from negative Y" @onclick="@(() => SelectDirectionAsync(CardinalDirection.NegativeY))" @onclick:stopPropagation><span>-Y</span></button>
            <button type="button" class="view-cube-face view-cube-face-positive-z" data-view-cube-normal="0,0,1" title="View +Z" aria-label="View from positive Z" @onclick="@(() => SelectDirectionAsync(CardinalDirection.PositiveZ))" @onclick:stopPropagation><span>+Z</span></button>
            <button type="button" class="view-cube-face view-cube-face-negative-z" data-view-cube-normal="0,0,-1" title="View -Z" aria-label="View from negative Z" @onclick="@(() => SelectDirectionAsync(CardinalDirection.NegativeZ))" @onclick:stopPropagation><span>-Z</span></button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public EventCallback<CardinalDirection> OnDirectionSelected { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback<PointerEventArgs> OnCameraPointerDown { get; set; }

    [Parameter]
    public EventCallback<PointerEventArgs> OnCameraPointerMove { get; set; }

    [Parameter]
    public EventCallback<PointerEventArgs> OnCameraPointerUp { get; set; }

    private ElementReference _overlayElement;
    private ElementReference _rotorElement;
    private long? _activePointerId;
    private double _pointerDownX;
    private double _pointerDownY;
    private bool _suppressNextDirectionSelection;

    private const double DragClickThresholdSquared = 16;

    internal ElementReference OverlayElement => _overlayElement;
    internal ElementReference RotorElement => _rotorElement;

    private async Task HandlePointerDownAsync(PointerEventArgs eventArgs)
    {
        if (eventArgs.Button is not (0 or 2))
            return;

        _activePointerId = eventArgs.PointerId;
        _pointerDownX = eventArgs.ClientX;
        _pointerDownY = eventArgs.ClientY;
        _suppressNextDirectionSelection = false;
        await OnCameraPointerDown.InvokeAsync(eventArgs);
    }

    private async Task HandlePointerMoveAsync(PointerEventArgs eventArgs)
    {
        if (_activePointerId != eventArgs.PointerId)
            return;

        var deltaX = eventArgs.ClientX - _pointerDownX;
        var deltaY = eventArgs.ClientY - _pointerDownY;
        if (deltaX * deltaX + deltaY * deltaY >= DragClickThresholdSquared)
            _suppressNextDirectionSelection = true;

        await OnCameraPointerMove.InvokeAsync(eventArgs);
    }

    private async Task HandlePointerUpAsync(PointerEventArgs eventArgs)
    {
        if (_activePointerId != eventArgs.PointerId)
            return;

        _activePointerId = null;
        await OnCameraPointerUp.InvokeAsync(eventArgs);
    }

    private async Task SelectDirectionAsync(CardinalDirection direction)
    {
        if (_suppressNextDirectionSelection)
        {
            _suppressNextDirectionSelection = false;
            return;
        }

        await OnDirectionSelected.InvokeAsync(direction);
    }
}
