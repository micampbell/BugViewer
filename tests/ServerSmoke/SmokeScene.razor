@page "/"
@using System.Numerics
@using BugViewer
@using Microsoft.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components
<h1>Interactive Server smoke test</h1>
<p role="status">@status</p>
<BugViewer @ref="viewer" Width="960px" Height="600px" OnReady="ReadyAsync" />
@code {
    private global::BugViewer.BugViewer? viewer;
    private string status = "Initializing";
    private async Task ReadyAsync()
    {
        await viewer!.PauseRenderingAsync();
        try
        {
            await viewer.AddMeshesAsync([
                new MeshData { Id = "uniform", Vertices = [new(-2,0,0), new(0,0,0), new(-1,2,0)],
                    Indices = [(0,1,2)], Colors = [ColorRgba.Red], ColorMode = MeshColoring.UniformColor },
                new MeshData { Id = "triangle", Vertices = [new(1,0,0), new(3,0,0), new(2,2,0)],
                    Indices = [(0,1,2)], Colors = [new(30,100,240,160)], ColorMode = MeshColoring.PerTriangle }
            ]);
            await viewer.AddLinesAsync(new LineData { Id = "line", Vertices = [new(-2,-1,0), new(3,-1,0)],
                Thicknesses = [.05f], FadeFactors = [0], Colors = [ColorRgba.Red] });
            await viewer.AddTextBillboardAsync("label", "Server interop", new(0,3,0), new(0,0,0,0), ColorRgba.White, .3f, .5f, .5f);
            status = "PASS: server circuit uploaded two meshes, a line, and a billboard";
        }
        finally { await viewer.ResumeRenderingAsync(); }
        await InvokeAsync(StateHasChanged);
    }
}
